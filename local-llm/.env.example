# Copy to .env and adjust. All values are optional.

# Gemma model tag from https://ollama.com/library/gemma3
#   gemma3:1b   ~0.8 GB  any machine, fastest, weakest
#   gemma3:4b   ~3.3 GB  default; fine on a CPU with 8 GB+ RAM
#   gemma3:12b  ~8 GB    wants 16 GB+ RAM or a GPU with 12 GB+ VRAM
#   gemma3:27b  ~17 GB   GPU with 24 GB+ VRAM
OLLAMA_MODEL=gemma3:4b

# Host port and bind address for the API.
OLLAMA_PORT=11434
OLLAMA_BIND=127.0.0.1

# How long a model stays loaded in memory after the last request.
OLLAMA_KEEP_ALIVE=10m

# Pin an Ollama release instead of latest, e.g. 0.12.3
OLLAMA_IMAGE_TAG=latest
